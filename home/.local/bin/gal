#!/bin/sh
set -e

case "$1" in
	build)
		sed '/^---$/,$d' .galrc | sh -
		exit
		;;
	debug)
		sed '/^---$/d' .galrc | sh -
		exit
		;;
esac

path="$(realpath -- "${1:-"$PWD"}")"
name="$(printf -- '%s' "${2:-"$(basename -- "$path")"}" | tr -c '[:alnum:]_-' '_')"

if [ ! -d "$path" ]
then
	printf -- '%s: %s: no such directory\n' "$0" "$path"
	exit 1
fi

if tmux new-session -dc "$path" -s "$name" kak-dialog lf -C "$name" 2>/dev/null
then
    # enforce dwm-like layout
	tmux set-option -t "$name" main-pane-width 60%
	tmux set-hook -t "$name" window-layout-changed 'select-layout main-vertical-mirrored'

	tmux new-window -dt "$name:2" -c "$path" sleep infinity
	tmux set-option -wt "$name:2" remain-on-exit on
fi

if [ "$TMUX" ]
then
	exec tmux switch-client -t "$name"
else
	exec tmux attach-session -t "$name"
fi
