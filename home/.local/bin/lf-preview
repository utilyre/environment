#!/bin/sh
set -e

mkdir -p -- "$LF_CACHE/thumbnails"

# delete all but the 100 newest thumbnails
find "$LF_CACHE/thumbnails" -mindepth 1 -maxdepth 1 -type f -printf '%T@\t%p\n' |
	sort -n |
	head -n-100 |
	cut -f2 |
	xargs -d'\n' rm -f

mime="$(file -b --mime-type -- "$1")"

# genthumb <input> <output>
genthumb() {
	case "$mime" in
		application/pdf) magick -density 150 -background white "$1[0]" -resize 512x -flatten "$2" ;;
		*) ffmpeg -i "$1" -frames:v 1 -filter:v scale=512:-1 -- "$2" ;;
	esac
}

case "$mime" in
	application/pdf | audio/* | image/* | video/*)
		thumbnail="$LF_CACHE/thumbnails/$(printf '%s:%s' "$1" "$(stat -c%Y -- "$1")" | base64 -w0).png"
		if [ ! -f "$thumbnail" ] && ! genthumb "$1" "$thumbnail"
		then
			file -b -- "$1" | fold -sw "$2"
			exit 1
		fi

		chafa \
			--animate=off \
			--polite=on \
			--bg=black \
			--threshold=1 \
			--format=sixel \
			--size="${2}x${3}" \
			-- "$thumbnail"
		;;
	text/*) cat -- "$1" | fold -sw "$2" ;;
	*) file -b -- "$1" | fold -sw "$2" ;;
esac
