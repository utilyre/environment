#!/bin/sh
set -e

# ignore USR1 signals
trap : USR1

while true
do
	session="$(tmux ls | wc -l)"
	if [ "$session" -gt 0 ]
	then
		session="[$session]"
	else
		session=
	fi

	keyboard=none
	case "$(swaymsg -t get_inputs | jq -r 'map(select(has("xkb_active_layout_name")))[0].xkb_active_layout_name')" in
		"English (US)") keyboard=en ;;
		"Persian") keyboard=fa ;;
	esac

	batperc="$(cat /sys/class/power_supply/BAT0/capacity)"
	if [ "$(cat /sys/class/power_supply/BAT0/status)" = Charging ] # is charging
	then
		battery="^$batperc%"
	elif [ "$batperc" -le 20 ] # is discharging
	then
		battery="<span color='red'>$batperc%</span>"
	else # is normal
		battery="$batperc%"
	fi

	date="$(date +'%a %-d %b')"
	time="$(date +'%I:%M %p')"

	# invalidate weather cache every hour
	# if [ -z "$weather" ] || [ "$(date +%s)" -gt "$((weather_time + 3600))" ]
	# then
	# 	weather="$(curl "https://wttr.in/$(tr '\n' , < "$XDG_CONFIG_HOME/coords")?format=%c" | tr -d ' ')"
	# 	weather_time="$(date +%s)"
	# fi

	printf '<span letter_spacing="512">%s     %s     %s     %s     %s     </span>\n' \
		"$session" \
		"$keyboard" \
		"$battery" \
		"$date" \
		"$time"

	sleep 10 &
	# an ignored USR1 signal interupts wait
	wait -- "$!" || true
done
