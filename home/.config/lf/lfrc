set incsearch true

set scrolloff 1
set ratios 1:1
set dupfilefmt '%b~%n%e'

set watch true
set preload true
set previewer lf-preview

setlocal ~/Downloads sortby time
setlocal ~/Downloads reverse true

set mouse true
map <space> toggle
map ~ filter
map X delete
map a create
map R bulk-rename

cmd create %{{
	printf 'create: '
	read -r file
	if [ -z "$file" ]
	then
		printf 'create: missing file operand\n'
		exit 1
	fi

	if [ -e "$file" ]
	then
		printf 'create: file exists\n'
		exit 1
	fi

	if [ "$(printf '%s' "$file" | tail -c1)" = / ]
	then
		mkdir -p -- "$file"
	else
		mkdir -p -- "$(dirname -- "$file")" && touch -- "$file"
	fi
}}

cmd bulk-rename !{{
	set -e

	printf '%s\n' "$fx" | xargs -d '\n' realpath -s --relative-to="$PWD" | vidir -v -
	lf -remote "send $id unselect"
}}

cmd gal &sleep 2 && setsid -f foot gal "$@"
