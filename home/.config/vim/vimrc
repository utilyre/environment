syntax on
colorscheme desert
set termguicolors
set mouse=a
set number
set scrolljump=-50
set pumheight=16
set wildcharm=<tab>
set expandtab
set autoindent
set shiftwidth=4
set tabstop=4
set hlsearch
set list
set listchars=tab:>\ ,trail:\\u00b7 " middot codepoint

noremap k gk
noremap j gj
noremap gk k
noremap gj j

noremap <space>y "+y
noremap <space>p "+p
noremap <space>P "+P
noremap <m-d> "_d
noremap <m-c> "_c
" TIP: use capital p to leave register unchanged

nnoremap <space>e :e %:h<tab>

nnoremap <silent> <expr> <space>q empty(filter(getwininfo(), 'v:val.quickfix')) ? ':copen<cr>' : ':cclose<cr>'
nnoremap <silent> [q :cprevious<cr>
nnoremap <silent> ]q :cnext<cr>

let s:last_cmd = ''
function! RunCommand()
    let l:cmd = input('Command: ', s:last_cmd, 'shellcmdline')
    if !empty(l:cmd)
        let s:last_cmd = l:cmd
        execute 'terminal ' . l:cmd
    endif
endfunction
function! RepeatCommand()
    if !empty(s:last_cmd)
        execute 'terminal ' . s:last_cmd
    endif
endfunction
nnoremap <silent> <space>: :call RunCommand()<cr>
nnoremap <silent> <space>. :call RepeatCommand()<cr>
