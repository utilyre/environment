syntax on
set number
set numberwidth=6
set mouse=a
set nowrap
set splitright
set splitbelow
set scrolljump=-50
set path+=** " perform :find in subdirectories
set noshowmode
set laststatus=2
set colorcolumn=80,100
set pumheight=16
set wildoptions+=pum
set expandtab
set autoindent
set shiftwidth=4
set tabstop=4
set hlsearch
set wildchar=<c-n>
set wildcharm=<c-n>
set list
set listchars=trail:\\u00b7 " middot codepoint
set termguicolors
set background=dark
colorscheme gruvbox

noremap <space>y "+y
noremap <space>p "+p
noremap <space>P "+P
noremap <m-d> "_d
noremap <m-c> "_c

noremap <space>e :e %:h<c-n>

noremap <silent> <expr> <space>q empty(filter(getwininfo(), 'v:val.quickfix')) ? ':copen<cr>' : ':cclose<cr>'
noremap <silent> [q :cprevious<cr>
noremap <silent> ]q :cnext<cr>
