syntax on
filetype plugin indent on

set mouse=a

set splitright
set splitbelow

" find in all subdirectories
set path+=**

set hlsearch
set number
set numberwidth=6
set textwidth=100

set laststatus=2
set colorcolumn=+1
set pumheight=16

set expandtab
set autoindent
set shiftwidth=4
set tabstop=4

set background=dark
set termguicolors
colorscheme gruvbox
match Error /\s\+$/
