syntax on
set number
set numberwidth=6
set mouse=a
set nowrap
set splitright
set splitbelow
set scrolljump=-50
set path+=** " perform :find in subdirectories
set noshowmode
set laststatus=2
set colorcolumn=80,100
set pumheight=16
set expandtab
set autoindent
set shiftwidth=4
set tabstop=4
set hlsearch
set wildcharm=<tab>
set list
set listchars=trail:\\u00b7 " middot codepoint
set termguicolors
set background=dark
colorscheme gruvbox

noremap <space>y "+y
noremap <space>p "+p
noremap <space>P "+P
noremap <m-d> "_d
noremap <m-c> "_c

nnoremap <space>e :e %:h<tab>

noremap <silent> <space>c :cgetbuffer<cr>
nnoremap <silent> <expr> <space>q empty(filter(getwininfo(), 'v:val.quickfix')) ? ':copen<cr>' : ':cclose<cr>'
nnoremap <silent> [q :cprevious<cr>
nnoremap <silent> ]q :cnext<cr>

nnoremap <silent> <space>x :execute 'terminal ' . input('Command: ')<cr>
nnoremap <silent> <f9> :terminal gal build<cr>
nnoremap <silent> <f5> :terminal gal debug<cr>
