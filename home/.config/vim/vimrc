nnoremap <silent> [q :cprevious<cr>
nnoremap <silent> ]q :cnext<cr>

let s:last_cmd = ''
function s:PromptAndRunCommand()
    let l:cmd = input('Command: ', s:last_cmd, 'shellcmdline')
    if !empty(l:cmd)
        let s:last_cmd = l:cmd
        call term_start([&shell, &shellcmdflag, l:cmd], {'term_name': '!' . l:cmd})
    endif
endfunction
function s:RepeatLastCommand()
    if empty(s:last_cmd)
        echohl ErrorMsg
        echo 'No command to execute'
        echohl None
   else
        call term_start([&shell, &shellcmdflag, s:last_cmd], {'term_name': '!' . s:last_cmd})
    endif
endfunction
nnoremap <silent> <space>x :call <sid>PromptAndRunCommand()<cr>
nnoremap <silent> <f5> :call <sid>RepeatLastCommand()<cr>
