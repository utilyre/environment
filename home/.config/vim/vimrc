let g:gruvbox_invert_selection = 0
colorscheme gruvbox
syntax on

set termguicolors
set background=dark
set mouse=a
set number
set scrolljump=-50
set pumheight=16
set wildcharm=<tab>
set expandtab
set autoindent
set shiftwidth=4
set tabstop=4
set hlsearch
set list
set listchars=tab:>\ ,trail:\\u00b7 " middot codepoint
set viminfofile=NONE
let g:netrw_dirhistmax = 0

" keymap reset
noremap k gk
noremap j gj
noremap gk k
noremap gj j
noremap Y y$

" clipboard helpers
noremap <space>y "+y
noremap <space>p "+p
noremap <space>P "+P
noremap <m-d> "_d
noremap <m-c> "_c
" TIP: use capital p to leave register unchanged

nnoremap <space>e :e %:h<tab>
nnoremap <silent> [q :cprevious<cr>
nnoremap <silent> ]q :cnext<cr>

" emulate emacs compiler mode
let s:last_cmd = ''
function s:PromptAndRunCommand()
    let l:cmd = input('Command: ', s:last_cmd, 'shellcmdline')
    if !empty(l:cmd)
        let s:last_cmd = l:cmd
        call term_start([&shell, &shellcmdflag, l:cmd], {'term_name': '!' . l:cmd})
    endif
endfunction
function s:RepeatLastCommand()
    if empty(s:last_cmd)
        echohl ErrorMsg
        echo 'No command to execute'
        echohl None
   else
        call term_start([&shell, &shellcmdflag, s:last_cmd], {'term_name': '!' . s:last_cmd})
    endif
endfunction
nnoremap <silent> <space>x :call <sid>PromptAndRunCommand()<cr>
nnoremap <silent> <f5> :call <sid>RepeatLastCommand()<cr>
