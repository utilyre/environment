browser xdg-open
prepopulate-query-feeds yes

unbind-key j
unbind-key k
bind-key k up
bind-key j down
bind-key ^u halfpageup
bind-key ^d halfpagedown
bind-key g home
bind-key G end

color background default default
color title default default bold
color info default default reverse
color listnormal default default dim
color listfocus green default reverse
color listnormal_unread default default
color listfocus_unread green default reverse
color listnormal_deleted default default
color listfocus_deleted green default reverse
color end-of-text-marker default default bold dim
highlight article "^[A-Z][0-9A-Za-z]*: .+$" default default bold dim
highlight article "[A-Za-z]+://[^ ]+" cyan default underline
highlight article "\\[[0-9]+\\]" cyan default underline
highlight article "\\[image [0-9]+.*\\]" cyan default underline
