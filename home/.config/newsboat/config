browser "xdg-open %u >/dev/null 2>&1 &"
prepopulate-query-feeds yes
show-keymap-hint no
swap-title-and-hints yes

unbind-key j
unbind-key k
bind-key k up
bind-key j down
bind-key ^u halfpageup
bind-key ^d halfpagedown
bind-key g home
bind-key G end

color background default default
color title default default reverse
color listnormal default default dim
color listnormal_unread default default
color listnormal_deleted red default
color listfocus default color8 dim
color listfocus_unread default color8
color listfocus_deleted red color8
color end-of-text-marker default default bold dim
highlight article "^[A-Z][0-9A-Za-z]*: .+$" default default bold dim
highlight article "[A-Za-z]+://[^ ]+" cyan default underline
highlight article "\\[[0-9]+\\]" green default bold
highlight article "\\[image [0-9]+.*\\]" green default bold
